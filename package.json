{
  "name": "ncm-player",
  "productName": "Reverie",
  "version": "1.0.0",
  "description": "Reverie — 一款音乐播放器",
  "type": "module",
  "main": "electron/main.cjs",
  "author": {
    "name": ""
  },
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "concurrently -k -s first \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.cjs\" \"scripts/*.cjs\" \"scripts/*.mjs\" \"vite.config.ts\" \"electron-builder.config.cjs\" \"*.{json,html,md}\"",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.config.cjs",
    "test:api": "node scripts/test-api.cjs",
    "test:e2e": "node scripts/e2e-test.mjs"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "cross-env": "^10.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.0.0",
    "wait-on": "^9.0.0",
    "zustand": "^5.0.0"
  }
}
